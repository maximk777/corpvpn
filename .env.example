# Скопируй в .env и заполни СВОИМИ значениями. .env в git не попадает (см. .gitignore).
# Все корп-специфичные адреса держи только здесь -- в репозитории их нет.

# ssh-таргет твоего РФ-VPS, через который выходит трафик (egress с его IP).
# Нужен для `corpvpn setup` -- он поставит autossh-туннель до него.
SOCKS_HOST=root@YOUR_VPS_IP

# Адрес SOCKS5 глазами гостя. Сюда autossh биндит туннель до SOCKS_HOST.
# 192.168.64.1 = твой Mac глазами гостя (Lima), 1081 = порт РФ-туннеля.
SOCKS_ADDR=192.168.64.1:1081

# Завернуть DNS гостя в прокси. Требует TCP-DNS (options use-vc, уже включено).
PROXY_DNS=1

# Корп-шлюзы VPN. Список через пробел -- corpvpn берёт первый живой,
# переключаться между ними: `corpvpn gw <номер|подстрока>`.
VPN_GATEWAYS=vpn.corp.example:443 vpn2.corp.example:443 vpn3.corp.example:443

# Домены, которые резолвятся через корп-DNS (для /etc/resolver на Mac).
# Через пробел. Пусто = резолвер не настраивается.
CORP_DOMAINS=corp.example intranet.example

# Хосты для `corpvpn check` -- быстрая проверка, что за VPN всё доступно.
CHECK_HOSTS=wiki.corp.example gitlab.corp.example app.corp.example

# Корп-DNS вручную (обычно определяется сам). Через пробел.
CORP_DNS=

# Подсети для маршрутов на macOS. Пусто = взять автоматически из tun0 гостя.
CORP_SUBNETS=

# Уведомления macOS о смене состояния VPN. 0 = выключить.
NOTIFY=1

# Стейдж/k8s-домены через DNS, которые пушит OpenVPN (Cisco их не знает)
OVPN_DNS=
OVPN_DOMAINS=

# DNS: primary = корп-DNS основным (без списков доменов, резолвится всё) |
#      resolver = per-domain /etc/resolver из CORP_DOMAINS (не трогает глобальный DNS)
DNS_MODE=primary
