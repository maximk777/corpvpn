<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Пользовательский LaunchAgent демона желаемого состояния (`corpvpn daemon`).
  install.sh копирует файл в ~/Library/LaunchAgents/com.corpvpn.daemon.plist;
  RunAtLoad + KeepAlive означают, что конвергенцией владеет launchd: старт на
  логине, автоматический перезапуск при падении. Путь бинаря фиксированный --
  root-owned копия из install.sh, не симлинк в репозиторий.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.corpvpn.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/corpvpn</string>
		<string>daemon</string>
	</array>
	<!-- Подменяется на корень репозитория при установке (install.sh, sed):
	     launchd стартует daemon с cwd=/, а бинарь -- root-owned копия, поэтому
	     repoRoot() находит .env только по этой директории. -->
	<key>WorkingDirectory</key>
	<string>__REPO_ROOT__</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<!-- launchd стартует демон с минимальным PATH (/usr/bin:/bin:...), из
	     которого недоступен limactl (Homebrew) на этапе reconcile env.
	     install.sh подменяет оба плейсхолдера (__REPO_ROOT__, __USER_HOME__). -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<!-- Без этих ключей stdout/stderr демона под launchd уходят в никуда:
	     дебажить клин или падение тика нечем. -->
	<key>StandardOutPath</key>
	<string>__USER_HOME__/Library/Logs/corpvpn-daemon.log</string>
	<key>StandardErrorPath</key>
	<string>__USER_HOME__/Library/Logs/corpvpn-daemon.log</string>
</dict>
</plist>
